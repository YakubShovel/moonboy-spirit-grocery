<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title and title != "Home" %}{{ title }} — {% endif %}moonboy spirit grocery</title>
  <meta name="description" content="moonboy spirit grocery. Nothing here is for sale.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;1,300;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/favicon.png">
</head>
<body class="{{ bodyClass or '' }}">
  <header class="awning">
    <div class="awning-canopy">
      <a href="/about/" class="awning-about">about</a>
