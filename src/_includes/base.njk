<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- set siteName = "Moonboy Spirit Grocery" %}
  {%- set tagline = "A grocery for those who love to live." %}
  {%- set pageTitle = (title + " — " + siteName) if (title and title != "Home") else (siteName + " — " + tagline) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ tagline }}">
  <link rel="canonical" href="https://moonboy-spirit-grocery.com{{ page.url }}">
  <meta property="og:site_name" content="{{ siteName }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ tagline }}">
  <meta property="og:url" content="https://moonboy-spirit-grocery.com{{ page.url }}">
  <meta property="og:image" content="https://moonboy-spirit-grocery.com/img/og-card.png">
  <meta property="og:type" content="website">
  <meta name="google-site-verification" content="6TbXrXC_nFX2HRDURyqMzP3nf_WtaCvO54XcsASgnOE" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inria+Serif:ital,wght@0,300;0,400;1,300;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="/img/favicon.png">
</head>
<body class="{{ bodyClass or '' }}">
  <header class="awning">
    <div class="awning-canopy"></div>
    <div class="awning-valance"></div>
    <a href="/" class="awning-sign" aria-label="Moonboy Spirit Grocery, home">
      <img src="/img/logo-badge.png" alt="Moonboy Spirit Grocery">
    </a>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <!-- foot traffic: GoatCounter, no cookies, no personal data -->
  <script data-goatcounter="https://moonboy.goatcounter.com/count"
          async src="//gc.zgo.at/count.js"></script>
</body>
</html>
