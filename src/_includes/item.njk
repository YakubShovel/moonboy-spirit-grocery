---
layout: base.njk
---
<article class="item-page item-page--{{ aisle }}">
  <header class="post-header">
    <span class="aisle-tag">{{ aisle }}{% if written %} · {{ written }}{% endif %}</span>
    <h1>{{ title }}</h1>
  </header>

  {%- if scan %}
  <figure class="scan">
    <a href="{{ scan }}"><img src="{{ scan }}" alt="Journal page: {{ title }}"></a>
  </figure>
  <details class="typed" open>
    <summary>typed up</summary>
    <div class="post-body poem">{{ content | safe }}</div>
  </details>
  {%- else %}
  {%- if youtube %}
  <div class="embed"><iframe src="https://www.youtube-nocookie.com/embed/{{ youtube }}" title="{{ title }}" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
  {%- endif %}
  <div class="post-body">{{ content | safe }}</div>
  {%- endif %}

  <p class="back"><a href="/">← back to the shelf</a></p>
</article>
