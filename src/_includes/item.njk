---
layout: base.njk
---
<article class="item-page item-page--{{ aisle }}">
  <header class="post-header">
    <span class="aisle-tag">{{ aisle }}</span>
    <h1>{{ title }}</h1>
    <time class="stocked" datetime="{{ page.date | htmlDateString }}">stocked {{ page.date | stockedDate }}</time>
  </header>

  {%- if aisle == "practice" %}
  <div class="post-body practice-page">{{ content | safe }}</div>
  {%- if scan %}
  <p class="aisle-tag practice-source">from the journal</p>
  <figure class="scan"><a href="{{ scan }}"><img src="{{ scan }}" alt="Journal page"></a></figure>
  {%- endif %}
  {%- elif scan %}
  <figure class="scan">
    <a href="{{ scan }}"><img src="{{ scan }}" alt="{{ content | striptags }}"></a>
  </figure>
  {%- else %}
  {%- if youtube %}
  <div class="embed"><iframe src="https://www.youtube-nocookie.com/embed/{{ youtube }}" title="{{ title }}" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
  {%- endif %}
  <div class="post-body">{{ content | safe }}</div>
  {%- endif %}

  <p class="back"><a href="/">← back to the shelf</a></p>
</article>
